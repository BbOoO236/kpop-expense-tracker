# ============================================================
# K-pop Fandom Expense Tracker — Backend environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- HTTP server ---
PORT=3000

# --- PostgreSQL connection (TypeORM `url`) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kpop_expense

# --- WeChat Mini-Program (code2session) ---
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# --- Auth ---
# Secret used to sign bearer tokens issued after WeChat login.
JWT_SECRET=change-me-to-a-long-random-string

# --- Runtime ---
NODE_ENV=development
