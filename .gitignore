# ============================================================
# K-pop Fandom Expense Tracker — root .gitignore
# ============================================================

# ---------- Dependencies ----------
node_modules/

# ---------- Build output ----------
dist/
build/
unpackage/
*.tsbuildinfo

# ---------- Environment / secrets ----------
# Never commit real credentials; keep the .env.example templates.
.env
.env.*
!.env.example

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ---------- Test coverage ----------
coverage/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---------- WeChat Mini-Program (machine-local) ----------
project.private.config.json
